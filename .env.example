# Bring your own keys. Only the provider you choose needs a key.
BLUNDERSTRUCK_PROVIDER=anthropic        # anthropic | gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Gemini model ids are not hard-coded; set both when BLUNDERSTRUCK_PROVIDER=gemini.
BLUNDERSTRUCK_GEMINI_SMART_MODEL=
BLUNDERSTRUCK_GEMINI_FAST_MODEL=
# Stockfish binary (defaults to `stockfish` on PATH).
STOCKFISH_PATH=
# Optional: a Lichess personal token raises rate limits. No scopes needed.
LICHESS_TOKEN=
# Sent as User-Agent contact to Chess.com / Lichess, as their API guidelines ask.
BLUNDERSTRUCK_CONTACT=
