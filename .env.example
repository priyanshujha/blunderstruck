# Copy to .env (read from the working directory, or pass --env <path>) and fill in what you need.
# Variables already set in your shell win over this file.
# Without any model key the report still prints, with numbers and template wording.

# Anthropic API key for the coach wording.
ANTHROPIC_API_KEY=
# Gemini API key for the coach wording.
GEMINI_API_KEY=
# Used when GEMINI_API_KEY is not set.
GOOGLE_API_KEY=
# anthropic, gemini or none; by default the first provider with a key is used.
BLUNDERSTRUCK_PROVIDER=
# Gemini model id for the weekly plan; defaults to gemini-3.8-flash.
BLUNDERSTRUCK_GEMINI_SMART_MODEL=
# Overrides the model id for the weekly plan, for either provider.
BLUNDERSTRUCK_MODEL_WEEKLY_PLAN=
# Database file; defaults to ~/.blunderstruck/blunderstruck.db (--db wins over this).
BLUNDERSTRUCK_DB=
# Contact (email or URL) sent in the User-Agent to Chess.com and Lichess, as their API guidelines ask.
BLUNDERSTRUCK_CONTACT=
# Optional Lichess personal token (no scopes needed); raises rate limits.
LICHESS_TOKEN=
# Stockfish binary; defaults to `stockfish` on PATH.
STOCKFISH_PATH=
